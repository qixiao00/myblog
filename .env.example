# Copy to .env.local; never commit credentials.
POSTGRES_URL=
TWIKOO_UPSTREAM_URL=

# Recommended: independent random secret, at least 32 characters.
# If omitted, existing POSTGRES_URL is used to derive the session encryption key.
ADMIN_SESSION_SECRET=

# Optional; otherwise the owner connects GitHub inside /admin.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPO=qixiao00/myblog
ADMIN_GITHUB_BRANCH=master

# Server-only credentials: scrypt salt (16 bytes hex):digest (64 bytes hex).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
