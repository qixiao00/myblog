---
interface Props {
  limit?: number;
  compact?: boolean;
}

const { limit = 6, compact = false } = Astro.props;
const enabled = Boolean(
  import.meta.env.TWIKOO_UPSTREAM_URL || import.meta.env.PUBLIC_TWIKOO_ENV_ID,
);
---

<section
  data-twikoo-recent
  data-twikoo-enabled={enabled ? "true" : "false"}
  data-twikoo-limit={limit}
  data-twikoo-compact={compact ? "true" : "false"}
>
  <div class="flex items-center justify-between gap-3">
    <h2 class={compact ? "text-xl font-semibold tracking-tight text-[var(--foreground)]" : "text-2xl font-semibold tracking-tight text-[var(--foreground)]"}>最新留言</h2>
    <a
      href="/guestbook"
      class="inline-flex items-center rounded-full border border-[var(--border)]/80 px-3 py-1.5 text-xs text-[var(--accent)] transition hover:border-[var(--accent)]/50 hover:bg-[var(--soft)]"
    >
      去留言
    </a>
  </div>
  <div data-twikoo-recent-list class="mt-4 space-y-3">
    <p class="text-sm text-[var(--muted)]">留言加载中...</p>
  </div>
</section>

<script>
  type GuestbookComment = {
    nick?: string;
    comment?: string;
    created: string | number;
  };

  const escapeHtml = (value: unknown) => String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

  const commentText = (html: unknown) => {
    const documentFragment = new DOMParser().parseFromString(String(html ?? ""), "text/html");
    return documentFragment.body.textContent?.trim() ?? "";
  };

  const formatTime = (timestamp: string | number) => new Intl.DateTimeFormat("zh-CN", {
    month: "numeric",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(timestamp));

  const cacheKey = "twikoo-recent:/guestbook";

  const renderComments = (container: HTMLElement, comments: GuestbookComment[], compact: boolean) => {
    const list = container.querySelector<HTMLElement>("[data-twikoo-recent-list]");
    if (!list) return;

    if (!comments.length) {
      list.innerHTML = '<p class="text-sm text-[var(--muted)]">还没有留言，欢迎来写第一条。</p>';
      return;
    }

    const avatarSize = compact ? "h-10 w-10" : "h-11 w-11";
    list.innerHTML = comments.map((comment) => {
      const nickname = escapeHtml(comment.nick || "匿名");
      const content = escapeHtml(commentText(comment.comment));
      const initial = escapeHtml((comment.nick || "匿").trim().slice(0, 1) || "匿");
      return `
        <article class="rounded-2xl border border-[var(--border)]/80 bg-[var(--panel)] px-3 py-3">
          <div class="flex items-start gap-3">
            <div class="${avatarSize} flex shrink-0 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--soft)]/70 text-sm text-[var(--accent)]">${initial}</div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-3">
                <p class="truncate font-medium text-[var(--foreground)]">${nickname}</p>
                <time class="shrink-0 text-xs text-[var(--muted)]">${formatTime(comment.created)}</time>
              </div>
              <p class="mt-2 line-clamp-3 whitespace-pre-wrap text-sm leading-7 text-[var(--muted)]">${content}</p>
            </div>
          </div>
        </article>`;
    }).join("");
  };

  const loadRecentComments = async (container: HTMLElement) => {
    const limit = Number(container.dataset.twikooLimit ?? 6);
    const compact = container.dataset.twikooCompact === "true";
    const list = container.querySelector<HTMLElement>("[data-twikoo-recent-list]");
    if (container.dataset.twikooEnabled !== "true") {
      if (list) list.textContent = "留言区暂未启用。";
      return;
    }

    const cached = sessionStorage.getItem(cacheKey);
    if (cached) {
      try {
        const { comments } = JSON.parse(cached) as { comments: GuestbookComment[] };
        if (Array.isArray(comments)) renderComments(container, comments, compact);
      } catch {
        sessionStorage.removeItem(cacheKey);
      }
    }

    const response = await fetch("/api/twikoo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        event: "COMMENT_GET",
        accessToken: localStorage.getItem("twikoo-access-token"),
        url: "/guestbook",
        sort: "DESC",
      }),
    });
    if (!response.ok) throw new Error("Twikoo request failed");

    const payload = await response.json() as { accessToken?: string; data?: GuestbookComment[] };
    if (payload.accessToken) localStorage.setItem("twikoo-access-token", payload.accessToken);
    const comments = (Array.isArray(payload.data) ? payload.data : []).slice(0, limit);
    sessionStorage.setItem(cacheKey, JSON.stringify({ comments }));
    renderComments(container, comments, compact);
  };

  document.querySelectorAll<HTMLElement>("[data-twikoo-recent]").forEach((container) => {
    loadRecentComments(container).catch(() => {
      const list = container.querySelector<HTMLElement>("[data-twikoo-recent-list]");
      if (list && list.textContent?.includes("留言加载中")) {
        list.textContent = "留言加载失败，请稍后刷新重试。";
      }
    });
  });
</script>
