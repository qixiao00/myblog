---
interface Props {
  path?: string;
  lang?: string;
  region?: string;
  cdnUrl?: string;
  title?: string;
}

const enabled = Boolean(
  import.meta.env.TWIKOO_UPSTREAM_URL || import.meta.env.PUBLIC_TWIKOO_ENV_ID,
);
const path = Astro.props.path;
const lang = Astro.props.lang ?? import.meta.env.PUBLIC_TWIKOO_LANG ?? "zh-CN";
const region = Astro.props.region ?? import.meta.env.PUBLIC_TWIKOO_REGION;
const cdnUrl =
  Astro.props.cdnUrl ??
  import.meta.env.PUBLIC_TWIKOO_JS_URL ??
  "/vendor/twikoo/twikoo.all.min.js";
const title = Astro.props.title ?? "评论";
---

<section class="twikoo-shell">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-2xl font-semibold tracking-tight text-[var(--foreground)]">{title}</h2>
    <span class="text-xs uppercase tracking-[0.24em] text-[var(--muted)]">Twikoo</span>
  </div>

  {enabled ? (
    <>
      <div id="twikoo-comments" class="mt-6"></div>

      <script is:inline define:vars={{ path, lang, region, cdnUrl }}>
        (() => {
          const containerId = "twikoo-comments";
          let started = false;

          const loadTwikoo = async () => {
            if (window.twikoo?.init) {
              return window.twikoo;
            }

            if (window.__twikooLoaderPromise) {
              return window.__twikooLoaderPromise;
            }

            window.__twikooLoaderPromise = new Promise((resolve, reject) => {
              const existing = document.querySelector('script[data-twikoo-loader="true"]');
              existing?.remove();

              const script = document.createElement("script");
              script.src = cdnUrl;
              script.defer = true;
              script.dataset.twikooLoader = "true";
              script.addEventListener("load", () => resolve(window.twikoo), { once: true });
              script.addEventListener(
                "error",
                () => reject(new Error("Twikoo script failed to load.")),
                { once: true },
              );
              document.head.append(script);
            }).catch((error) => {
              window.__twikooLoaderPromise = null;
              document.querySelector('script[data-twikoo-loader="true"]')?.remove();
              throw error;
            });

            return window.__twikooLoaderPromise;
          };

          const initTwikoo = async () => {
            if (started) {
              return;
            }
            started = true;

            const container = document.getElementById(containerId);
            if (!container) {
              return;
            }

            const commentPath = path || window.location.pathname;
            container.innerHTML = "";

            try {
              const twikoo = await loadTwikoo();
              await twikoo.init({
                envId: `${window.location.origin}/api/twikoo`,
                el: `#${containerId}`,
                path: commentPath,
                lang,
                requiredMeta: ["nick", "mail"],
                ...(region ? { region } : {}),
              });
            } catch (error) {
              started = false;
              console.error("[Twikoo] Failed to initialize comments.", error);
              container.innerHTML = '<p class="twikoo-state">评论加载失败，请稍后重试。 <button type="button" data-twikoo-retry>重试</button></p>';
              container.querySelector("[data-twikoo-retry]")?.addEventListener("click", initTwikoo, { once: true });
            }
          };

          const boot = () => {
            const container = document.getElementById(containerId);
            if (!container) {
              return;
            }

            if (!("IntersectionObserver" in window)) {
              initTwikoo();
              return;
            }

            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    observer.disconnect();
                    initTwikoo();
                    break;
                  }
                }
              },
              {
                rootMargin: "240px 0px",
                threshold: 0.01,
              },
            );

            observer.observe(container);
          };

          const scheduleBoot = () => {
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", boot, { once: true });
              return;
            }

            boot();
          };

          scheduleBoot();
          document.addEventListener("astro:page-load", scheduleBoot);
        })();
      </script>
    </>
  ) : (
    <p class="twikoo-state mt-6">
      未检测到 <code>PUBLIC_TWIKOO_ENV_ID</code>，评论区暂未启用。
    </p>
  )}
</section>
