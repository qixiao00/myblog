---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";
import type { SidebarNode } from "../lib/notes";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  tree: SidebarNode[];
  currentNotePath?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  tree,
  currentNotePath,
} = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=3" />
    <title>{pageTitle}</title>
    <script is:inline>try{const direction=sessionStorage.getItem('journal-navigation-direction');if(direction==='forward'||direction==='back')document.documentElement.dataset.navigationDirection=direction;sessionStorage.removeItem('journal-navigation-direction');const theme=localStorage.getItem('journal-theme');if(theme==='light'||theme==='dark')document.documentElement.dataset.theme=theme}catch{}</script>
  </head>
  <body class="antialiased">
    <header class="blog-header glass-material">
      <a href="/" class="blog-brand"><strong>{SITE.title}</strong><span>文字 · 生活 · 看见</span></a>
      <nav aria-label="网站导航">
        {[{ href: "/", label: "首页" }, { href: "/notes", label: "笔记" }, { href: "/guestbook", label: "留言" }, { href: "/stats", label: "统计" }].map(item => <a href={item.href} aria-current={(item.href === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(item.href)) ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <div class="blog-tools"><button class="glass-control blog-menu" type="button" data-sidebar-toggle aria-label="打开文章目录" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button><button class="glass-control glass-theme-button" type="button" data-theme-toggle aria-label="切换明暗主题"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg></button></div>
    </header>
    <div class="blog-frame">
      <div data-sidebar-backdrop class="directory-backdrop hidden"></div>
      <aside data-sidebar-panel class="blog-directory"><Sidebar tree={tree} currentNotePath={currentNotePath} /></aside>
      <main class="blog-main"><slot /><footer class="blog-footer"><span>阿亓 · 请随意看看</span><a href="mailto:ikkym541@gmail.com">联系我 ↗</a><a href="/admin">编辑室 ↗</a></footer></main>
    </div>
    <script>import "../scripts/liquid-glass";</script>
    <script>import "../scripts/site-views";</script>
  </body>
</html>
