---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  buildSidebarTree,
  formatLongDate,
  getNoteFolderLabel,
  getNoteTitle,
  getRecentNotes,
  noteUrlFromId,
} from "../lib/notes";
import RecentGuestbook from "../components/RecentGuestbook.astro";
import { SITE } from "../lib/site";

const notes = await getCollection(
  "notes",
  ({ data }) => !import.meta.env.PROD || !data.draft,
);
const tree = buildSidebarTree(notes);
const recentNotes = getRecentNotes(notes, 6);
---

<BaseLayout title={SITE.title} description={SITE.description} tree={tree}>
  <section class="journal-hero">
    <img src="/images/site-bg.jpg" alt="街头阶梯上的行人，阳光从出口照进来" fetchpriority="high" width="1398" height="960" />
    <div class="hero-copy"><p class="hero-eyebrow">你好啊，我是亓 qí。</p><h1>把日常，<br />留在这里。</h1><p>写一些心情，记一些朋友。<br />也留下那些被照片记住的瞬间。</p><div class="hero-actions"><a href="/notes" class="glass-control primary">翻开笔记 <span class="hero-arrow">↗</span></a><a href="/guestbook" class="glass-control">给我留言</a></div></div>
    <div class="hero-caption">我的生活，在字里行间。</div>
  </section>
  <section class="journal-intro" aria-label="关于我的笔记">
    <article class="glass-material" data-reveal><span class="journal-kicker">写下那些情绪</span><h2>心情</h2><p>有一些情绪时想写的话。<br />让一时的心绪，有个落脚的地方。</p></article>
    <article class="glass-material" data-reveal><span class="journal-kicker">记住身边的人</span><h2>友人帐</h2><p>朋友总带来难以言说的感觉。<br />把关于他们的感受和回忆写下来。</p></article>
  </section>
  <section data-reveal>
    <div class="journal-section-heading"><div><span class="journal-kicker">最近写下的东西</span><h2>日子在更新。</h2></div><a href="/notes" class="glass-control">全部笔记 <span class="hero-arrow">↗</span></a></div>
    <div class="journal-columns"><div class="journal-list">{recentNotes.length ? recentNotes.map(note => <a href={noteUrlFromId(note.id)} class="journal-note glass-material glass-interactive"><div><h3>{getNoteTitle(note)}</h3><p>{getNoteFolderLabel(note.id)} · {formatLongDate(note.data.date)}</p>{note.data.description && <p>{note.data.description}</p>}</div><span class="journal-note-arrow" aria-hidden="true">↗</span></a>) : <p>还没有公开笔记。</p>}</div><aside class="journal-letters glass-material"><RecentGuestbook compact limit={4} /></aside></div>
  </section>
  <div class="journal-contact" data-reveal><p>关于照片、文字，或者只是打个招呼。<br /><a href="mailto:ikkym541@gmail.com">ikkym541@gmail.com ↗</a></p><p>祝你开心。</p></div>
</BaseLayout>
