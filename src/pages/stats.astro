---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getViewStats } from "../lib/engagement";
import { buildSidebarTree, noteUrlFromId } from "../lib/notes";
import { getTwikooCommentCount } from "../lib/twikoo";

const notes = await getCollection(
  "notes",
  ({ data }) => !import.meta.env.PROD || !data.draft,
);
const tree = buildSidebarTree(notes);
const [stats, commentCount] = await Promise.all([
  getViewStats(30),
  getTwikooCommentCount(["/guestbook", ...notes.map((note) => noteUrlFromId(note.id))]),
]);
---

<BaseLayout title="站点统计" description="站点访问与互动统计。" tree={tree}>
  <section>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[var(--foreground)]">站点统计</h1>
    <p class="mt-4 text-sm text-[var(--muted)]">全站访问量覆盖首页、笔记列表、文章、留言板和统计页，同一浏览器访问同一页面每天计一次；后台及已登录管理员的访问不计入。历史文章计数单独保留。</p>
  </section>

  <p class="mt-3 text-sm text-[var(--muted)]">{stats.siteStarted ? `全站统计开始于 ${new Date(stats.siteStarted).toLocaleDateString("zh-CN", { timeZone: "Asia/Shanghai" })}。` : "全站统计从本次更新后开始，更新前非文章页面的访问无法追溯。"}</p>

  <section class="mt-8 grid gap-4 md:grid-cols-3">
    <article class="surface-panel rounded-[1.5rem] p-5">
      <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">全站累计访问量</p>
      <p class="mt-3 text-4xl font-semibold text-[var(--foreground)]">{stats.siteViews === null ? "暂不可用" : stats.siteViews.toLocaleString("zh-CN")}</p>
    </article>
    <article class="surface-panel rounded-[1.5rem] p-5">
      <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">文章累计浏览量（含历史）</p>
      <p class="mt-3 text-4xl font-semibold text-[var(--foreground)]">{stats.postViews === null ? "暂不可用" : stats.postViews.toLocaleString("zh-CN")}</p>
    </article>
    <article class="surface-panel rounded-[1.5rem] p-5">
      <p class="text-xs uppercase tracking-[0.28em] text-[var(--muted)]">总评论数</p>
      <p class="mt-3 text-4xl font-semibold text-[var(--foreground)]">{commentCount === null ? "暂不可用" : commentCount.toLocaleString("zh-CN")}</p>
    </article>
  </section>

  <section class="mt-8 rounded-[1.5rem] border border-[var(--border)] bg-[var(--panel)] p-5">
    <h2 class="text-2xl font-semibold text-[var(--foreground)]">文章浏览量 Top</h2>
    {
      stats.topPosts.length > 0 ? (
        <div class="mt-5 overflow-x-auto">
          <table class="w-full min-w-[28rem] text-left text-sm">
            <thead>
              <tr class="border-b border-[var(--border)] text-[var(--muted)]">
                <th class="py-2 pr-4 font-medium">文章</th>
                <th class="py-2 pr-4 font-medium">路径</th>
                <th class="py-2 text-right font-medium">浏览量</th>
              </tr>
            </thead>
            <tbody>
              {stats.topPosts.map((row) => (
                <tr class="border-b border-[var(--border)]/60">
                  <td class="py-3 pr-4">
                    <a class="text-[var(--accent)] hover:opacity-80" href={noteUrlFromId(row.slug)}>
                      {row.slug.split("/").pop()}
                    </a>
                  </td>
                  <td class="py-3 pr-4 text-[var(--muted)]">{row.slug}</td>
                  <td class="py-3 text-right text-[var(--foreground)]">{row.views.toLocaleString("zh-CN")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="mt-4 text-sm text-[var(--muted)]">暂时还没有浏览数据。</p>
      )
    }
  </section>
</BaseLayout>
